# --- App ---
# URL publique de l'app (obligatoire en prod). Ex. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL canonique NextAuth / callbacks OAuth (obligatoire). Souvent égal à NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL=http://localhost:3000
# Secret de chiffrement des cookies de session NextAuth (obligatoire). openssl rand -base64 32
NEXTAUTH_SECRET=
# Environnement applicatif : development | staging | production (défaut: dérivé de NODE_ENV).
# Hors production : bandeau + refus des clés Stripe live (sk_live_).
APP_ENV=development
# Miroir public de APP_ENV pour Sentry client / bannières (optionnel ; sinon NODE_ENV).
NEXT_PUBLIC_APP_ENV=development
# Emails Discord OAuth autorisés à voir /dashboard/leads (séparés par des virgules).
# Ignoré si LEADS_ADMIN_DISCORD_IDS est défini.
LEADS_ADMIN_EMAILS=
# IDs Discord (snowflake) autorisés pour /dashboard/leads — préféré (plus stable que l’email).
LEADS_ADMIN_DISCORD_IDS=

# Secret Bearer pour POST /api/cron/access et /api/cron/retention
# (obligatoire en production et staging — fail-fast au boot).
# openssl rand -hex 32 — utilisé par access-cron + retention-cron
CRON_SECRET=

# Clé de chiffrement OAuth Discord + secrets Stripe formation
# (obligatoire en production et staging — fail-fast au boot).
# Aussi requis pour brancher une sk_ formation (dashboard accès).
# openssl rand -base64 32
# Après activation sur une base existante :
#   npm run seal-oauth        # jetons OAuth Discord
#   npm run seal-org-stripe   # sk_ / whsec_ formation
TOKEN_ENCRYPTION_KEY=

# --- Database (PostgreSQL) ---
# Mot de passe Postgres pour docker compose (optionnel en local ; défaut: discelyn). Pas lu par Node.
POSTGRES_PASSWORD=discelyn
# Chaîne Prisma / runtime (obligatoire). Adapter host (localhost vs db) selon Docker ou npm run dev.
# Local + docker-compose.dev.yml : port hôte 5434 (évite conflit Postgres Windows sur 5432).
DATABASE_URL=postgresql://discelyn:discelyn@localhost:5434/discelyn?schema=public
# Postgres dédié aux tests locaux (scripts/run-tests.mjs + docker-compose.test.yml, port 5433).
# DISCELYN_TEST_DATABASE_URL=postgresql://discelyn:discelyn@127.0.0.1:5433/discelyn?schema=public

# --- Redis (rate-limit multi-instance) ---
# URL Redis (obligatoire en production ; sans Redis le rate-limit bascule en mémoire processus).
REDIS_URL=redis://localhost:6379
# TRUST_PROXY : 0 en local (accès direct :3000 via npm run dev ou compose.dev).
# En production : TOUJOURS docker-compose.tls.yml / host-nginx (force TRUST_PROXY=1)
# via `npm run deploy:prod`. Le compose de base n’expose plus :3000 publiquement.
# Sans TRUST_PROXY=1 derrière un reverse-proxy, le rate-limit IP est inefficace.
TRUST_PROXY=0

# --- Deploy prod (scripts/deploy-prod.mjs) ---
# DOMAIN=discelyn.example.com
# EMAIL=admin@example.com
# TLS_MODE=caddy   # défaut : Caddy dans Docker
# TLS_MODE=nginx   # nginx hôte (après deploy/bootstrap-host.sh ou npm run provision:remote)
#
# --- Provision VPS distant (scripts/provision-remote.mjs) ---
# SSH_HOST=203.0.113.10
# SSH_USER=root
# SSH_KEY=%USERPROFILE%\.ssh\id_ed25519
# SSH_PUBKEY=ssh-ed25519 AAAA…   # optionnel si SSH_KEY.pub existe
# REMOTE_DIR=/opt/discelyn
# PROVISION_DEPLOY=1             # lance aussi docker compose après bootstrap

# --- Discord OAuth + bot plateforme (même application Developer Portal) ---
# Client ID OAuth (obligatoire). https://discord.com/developers/applications
DISCORD_CLIENT_ID=
# Client Secret OAuth (obligatoire). Même application.
DISCORD_CLIENT_SECRET=
# Token du bot plateforme Discelyn (obligatoire). JAMAIS un token utilisateur.
DISCORD_BOT_TOKEN=
# Redirect OAuth à ajouter dans le portail Discord (OAuth2 → Redirects) pour le claim apprenant :
# {NEXT_PUBLIC_APP_URL}/api/access/claim/callback

# --- Stripe ---
# Clé secrète API Stripe Discelyn (abonnements SaaS). Distinct du Stripe « formation » des clients
# (configuré dans le dashboard → Contrôle d’accès, webhook /api/access/webhook/{token}).
STRIPE_SECRET_KEY=
# Secret de signature des webhooks Stripe (obligatoire pour /api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=
# Price ID abonnement Starter (mensuel, 19,99 €).
STRIPE_PRICE_STARTER=
# Price ID abonnement Starter (annuel, 199,90 € — 2 mois offerts).
STRIPE_PRICE_STARTER_YEARLY=
# Price ID abonnement Ops (mensuel, 49 €).
STRIPE_PRICE_OPS=
# Price ID abonnement Ops (annuel, 490 € — 2 mois offerts).
STRIPE_PRICE_OPS_YEARLY=
# Price ID abonnement Scale (mensuel, 99 €).
STRIPE_PRICE_SCALE=
# Price ID abonnement Scale (annuel, 990 € — 2 mois offerts).
STRIPE_PRICE_SCALE_YEARLY=
# Price ID Setup Pilot (paiement one-shot, 290 €).
STRIPE_PRICE_SETUP=
# Price ID Diagnostic Discord (paiement one-shot, 49 €, crédit Setup).
STRIPE_PRICE_DIAGNOSTIC=
# En production : sk_test_ est refusé par défaut.
# ALLOW_STRIPE_TEST_IN_PROD=1 uniquement pour un dry-run temporaire.
# ALLOW_STRIPE_TEST_IN_PROD=0

# --- Bot runtime (processus discord.js séparé) ---
# URL HTTP du runtime pour reload / health (recommandé). Ex. http://localhost:4001
BOT_RUNTIME_URL=http://localhost:4001
# Secret Bearer partagé web ↔ runtime (obligatoire en staging/production ; aussi si BOT_RUNTIME_URL).
# Aussi utilisé par le runtime pour POST /api/internal/learner-join.
BOT_RUNTIME_SECRET=
# Port d'écoute du runtime (optionnel ; défaut 4001).
BOT_RUNTIME_PORT=4001
# URL du web vue depuis le runtime (grant on join). Compose : http://web:3000
WEB_INTERNAL_URL=http://localhost:3000
# Nombre de shards Discord in-process (optionnel ; défaut 1). Utile au-delà de ~1–2k guilds.
# Ne multiplie PAS les tokens : 1 bot = toujours un SPOF token.
# DISCORD_SHARD_COUNT=1

# --- Email (invite claim + relances apprenant) ---
# Resend API — **fortement recommandé en prod** pour les apprenants sans Discord ID
# encore lié (paiement email-only). Envoie l’invite claim dès le checkout + relances.
# Sans ces vars : webhook orga `claim_reminder` / DM Discord uniquement.
# Preflight prod : warning si absents.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Discelyn <noreply@votredomaine.com>

# --- Identité légale (RGPD / LCEN) — obligatoire en staging & production ---
# Affiché sur /privacy et /mentions-legales. Fail-fast au boot + preflight si manquant.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_LEGAL_ENTITY_COUNTRY=FR
# SIRET / SIREN optionnel (auto-entreprise, société).
# NEXT_PUBLIC_LEGAL_ENTITY_SIRET=
NEXT_PUBLIC_HOSTING_PROVIDER=
NEXT_PUBLIC_HOSTING_REGION=EU

# --- Monitoring (optionnels) ---
# DSN Sentry côté serveur (optionnel).
SENTRY_DSN=
# DSN Sentry côté client (optionnel ; sinon fallback sur SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=

# --- Compat (déprécié) ---
# DEMO_MODE=1 est encore accepté comme alias de APP_ENV=staging.

# --- TLS (docker-compose.tls.yml uniquement) ---
# Domaine public pour Caddy (obligatoire avec l'overlay TLS).
# DOMAIN=discelyn.example.com
# E-mail Let's Encrypt (obligatoire avec l'overlay TLS).
# EMAIL=admin@example.com
