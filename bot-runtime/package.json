    "dotenv": "^16.5.0",

    "pg": "^8.16.0"

  },

  "devDependencies": {

    "@types/node": "^20.17.57",

    "@types/pg": "^8.15.4",

    "tsx": "^4.20.3",

    "typescript": "^5.8.3"

  }

}


