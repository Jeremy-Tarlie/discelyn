{
  "name": "botly",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:e2e": "node scripts/run-tests.mjs --e2e",
    "preflight:prod": "node --env-file=.env scripts/preflight-prod.mjs",
    "backup:db": "node --env-file=.env scripts/backup-postgres.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:runtime": "npm --prefix bot-runtime run typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seal-oauth": "node --env-file=.env scripts/seal-oauth-tokens.mjs",
    "seal-org-stripe": "node --env-file=.env scripts/seal-org-stripe.mjs",
    "diagnostic-collect": "node scripts/diagnostic-collect.mjs",
    "postinstall": "prisma generate && node scripts/mark-prisma-esm.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.73.0",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.11",
    "next-intl": "^4.14.6",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^18.2.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.4",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
